        "correlation_caution": False
    }
    """
CityPulse - Integration Verification Script
Tests models, simulation, math consistency, AI assistant grounding, and HTTP server endpoints.
"""

import threading
import time
import urllib.request
import json
import sys

if hasattr(sys.stdout, 'reconfigure'):
    sys.stdout.reconfigure(encoding='utf-8')

from simulation import generate_scenario
from ai_engine import answer_query, format_say_bar
from app import ThreadingHTTPServer, CityPulseHandler

def test_simulation_math():
    print("[1/5] Testing Simulation Engine & Math Consistency...")
    for _ in range(20):
        scenario = generate_scenario("delhi_cp")
        loc_id = scenario["active_location_id"]
        central = scenario["zones"][loc_id]
        brk = central["breakdown"]
        
        assert 68 <= central["pulse"] <= 76, f"Pulse {central['pulse']} not in 68-76"
        sum_deductions = brk["weather_deduction"] + brk["transit_deduction"] + brk["incidents_deduction"] + brk["traffic_deduction"]
        assert sum_deductions == brk["total_deduction"], "Deduction sum mismatch"
        assert brk["normal_pulse"] - brk["total_deduction"] == brk["current_pulse"], "Normal - total != pulse"
        assert brk["current_pulse"] == central["pulse"], "Breakdown pulse != zone pulse"
    print("  ✓ 20 scenario variations verified: Math strictly balances!")

def test_ai_engine():
    print("[2/5] Testing AI Assistant Grounding & Guardrails...")
    state = generate_scenario("delhi_cp", target_pulse=71)
    
    # 1. Why score 71
    res1 = answer_query("Why is the score 71?", "en", state)
    assert "71" in res1["answer"] and "deduction" in res1["answer"].lower(), "Missing score breakdown"
    print("  ✓ 'Why score' query explains deductions.")

    # 2. Correlation vs Causation
    res2 = answer_query("Is the rain causing the delays?", "en", state)
    assert res2["correlation_caution"] is True, "Expected correlation caution flag"
    assert "possible correlation" in res2["answer"].lower(), "Expected 'possible correlation' phrasing"
    assert "definitely caused" in res2["answer"].lower(), "Expected caution against definite cause"
    print("  ✓ 'Is rain causing delays' strictly follows correlation-not-causation rule.")

    # 3. Resident guidance
    res3 = answer_query("What should residents do?", "en", state)
    assert "extra" in res3["answer"].lower() or "travel" in res3["answer"].lower(), "Missing travel advice"
    print("  ✓ 'What should residents do' provides actionable guidance.")

    # 4. Out of scope
    res4 = answer_query("Who is the mayor of New York?", "en", state)
    assert "not have access" in res4["answer"].lower() or "will not guess" in res4["answer"].lower(), "Expected hallucination refusal"
    print("  ✓ Hallucination refusal verified for out-of-scope query.")

def test_translations():
    print("[3/5] Testing English and Hindi Say Bar Prompters...")
    state = generate_scenario("delhi_cp", target_pulse=71)
    for step in range(1, 18):
        line_en = format_say_bar(step, "en", state)
        line_hi = format_say_bar(step, "hi", state)
        assert len(line_en) > 10, f"Empty English line for step {step}"
        assert len(line_hi) > 10, f"Empty Hindi line for step {step}"
    print("  ✓ All 17 steps formatted in both English and Hindi.")

def test_http_server():
    print("[4/5] Testing Live HTTP Server on Port 8008...")
    server = ThreadingHTTPServer(("localhost", 8008), CityPulseHandler)
    server_thread = threading.Thread(target=server.serve_forever, daemon=True)
    server_thread.start()
    time.sleep(0.5)

    try:
        # Test GET /
        with urllib.request.urlopen("http://localhost:8008/") as r:
            assert r.status == 200
            html = r.read().decode("utf-8")
            assert "CityPulse" in html
        print("  ✓ GET / serves index.html")

        # Test GET /api/state
        with urllib.request.urlopen("http://localhost:8008/api/state?lang=en&step=1") as r:
            assert r.status == 200
            data = json.loads(r.read().decode("utf-8"))
            assert data["current_step"] == 1
            assert "Welcome to CityPulse" in data["say_bar"]
        print("  ✓ GET /api/state returns dynamic state and Say Bar line")

        # Test POST /api/chat
        req = urllib.request.Request(
            "http://localhost:8008/api/chat",
            data=json.dumps({"message": "Why is the score 71?", "lang": "en"}).encode("utf-8"),
            headers={"Content-Type": "application/json"}
        )
        with urllib.request.urlopen(req) as r:
            assert r.status == 200
            chat_res = json.loads(r.read().decode("utf-8"))
            assert len(chat_res["answer"]) > 20
        print("  ✓ POST /api/chat responds with grounded telemetry")

        # Test GET /api/locations
        with urllib.request.urlopen("http://localhost:8008/api/locations") as r:
            assert r.status == 200
            loc_data = json.loads(r.read().decode("utf-8"))
            assert "India" in loc_data["locations"]
        print("  ✓ GET /api/locations returns geographic hierarchy tree")

        # Test POST /api/detect-location (Mumbai coords)
        req_gps = urllib.request.Request(
            "http://localhost:8008/api/detect-location",
            data=json.dumps({"lat": 19.07, "lon": 72.87}).encode("utf-8"),
            headers={"Content-Type": "application/json"}
        )
        with urllib.request.urlopen(req_gps) as r:
            assert r.status == 200
            gps_res = json.loads(r.read().decode("utf-8"))
            assert gps_res["detected_location"]["id"] == "mumbai_bkc"
        print("  ✓ POST /api/detect-location accurately resolves nearest GPS hub (Mumbai BKC)")

        # Test GET /api/export
        with urllib.request.urlopen("http://localhost:8008/api/export") as r:
            assert r.status == 200
            exp_data = json.loads(r.read().decode("utf-8"))
            assert "high_signal_metrics" in exp_data
            assert "location_hierarchy" in exp_data
        print("  ✓ GET /api/export generates structured civic intelligence report")

    finally:
        server.shutdown()
        server.server_close()
        print("  ✓ Server shut down cleanly.")

if __name__ == "__main__":
    print("\nStarting CityPulse Verification Suite...")
    test_simulation_math()
    test_ai_engine()
    test_translations()
    test_http_server()
    print("\n[5/5] ALL TESTS PASSED! Ready for VS Code and live demo presentation.\n")
