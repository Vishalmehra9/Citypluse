def get_location_hierarchy() -> Dict[str, Any]:
    """Returns a structured hierarchy tree for UI cascading dropdowns: Country -> State -> District -> Ward."""
    tree: Dict[str, Any] = {"India": {}}
    for loc in GEO_DATABASE:
        st = loc["state"]
        dist = loc["district"]
        area = loc["local_area"]
        if st not in tree["India"]:
            tree["India"][st] = {}
        if dist not in tree["India"][st]:
            tree["India"][st][dist] = []
        tree["India"][st][dist].append({
            "id": loc["id"],
            "local_area": area,
            "local_area_hi": loc.get("local_area_hi", area),
            "ward_code": loc["ward_code"],
            "pin_code": loc["pin_code"],
            "lat": loc["latitude"],
            "lon": loc["longitude"]
        })
    return tree

def generate_scenario(target_location_id: str = "delhi_cp", target_pulse: Optional[int] = None) -> Dict[str, Any]:
    legacy_map = {
        "central": "delhi_cp",
        "north": "noida_sec18",
        "south": "blr_koramangala",
        "west": "mumbai_bkc",
        "east": "kolkata_parkst"
    }
    if target_location_id in legacy_map:
        target_location_id = legacy_map[target_location_id]

    valid_ids = [g["id"] for g in GEO_DATABASE]
    if target_location_id not in valid_ids:
        target_location_id = "delhi_cp"

    if target_pulse is None:
        target_pulse = random.choice([69, 71, 72, 73, 74, 75])

    normal_pulse = random.choice([93, 94, 95])
    total_deduction = normal_pulse - target_pulse

    w_ded = max(4, round(total_deduction * 0.26))
    t_ded = max(5, round(total_deduction * 0.35))
    i_ded = max(3, round(total_deduction * 0.22))
    tr_ded = total_deduction - (w_ded + t_ded + i_ded)

    if tr_ded < 2:
        diff = 2 - tr_ded
        tr_ded = 2
        w_ded -= diff

    assert (w_ded + t_ded + i_ded + tr_ded) == total_deduction
    assert (normal_pulse - total_deduction) == target_pulse

    weather_info = random.choice(WEATHER_PRESETS)

    norm_delay = random.choice([4, 5])
    curr_delay = norm_delay + random.randint(12, 16)
    transit_pct = int(((curr_delay - norm_delay) / norm_delay) * 100)

    norm_incidents = random.choice([2, 3])
    curr_incidents = norm_incidents + random.randint(9, 12)
    incidents_pct = int(((curr_incidents - norm_incidents) / norm_incidents) * 100)
    threshold = 8

    traffic_pct = random.randint(62, 85)
    curr_speed = random.randint(12, 16)
    norm_speed = random.randint(40, 48)

    now = datetime.now()
    t4 = now.strftime("%H:%M")
    t3 = (now - timedelta(minutes=15)).strftime("%H:%M")
    t2 = (now - timedelta(minutes=30)).strftime("%H:%M")
    t1 = (now - timedelta(minutes=45)).strftime("%H:%M")

    zones_dict: Dict[str, Zone] = {}

    for geo in GEO_DATABASE:
        zid = geo["id"]
        loc = GeoLocation(
            country=geo["country"],
            country_code=geo["country_code"],
            state=geo["state"],
            state_hi=geo["state_hi"],
            district=geo["district"],
            district_hi=geo["district_hi"],
            local_area=geo["local_area"],
            local_area_hi=geo["local_area_hi"],
            latitude=geo["latitude"],
            longitude=geo["longitude"],
            ward_code=geo["ward_code"],
            pin_code=geo["pin_code"]
        )

        if zid == target_location_id:
            status = "Moderate Risk" if target_pulse >= 70 else "Elevated Risk"
            status_hi = "मध्यम जोखिम" if target_pulse >= 70 else "बढ़ा हुआ जोखिम"
            status_color = "amber" if target_pulse >= 70 else "orange"

            w_sig = WeatherSignal(
                condition=weather_info["en"],
                condition_hi=weather_info["hi"],
                temperature_c=weather_info["temp"],
                rainfall_mm=weather_info["rain"],
                aqi=weather_info["aqi"],
                aqi_status=weather_info["aqi_status"],
                aqi_status_hi=weather_info["aqi_status_hi"],
                icon=weather_info["icon"],
                deduction=w_ded
            )
            tr_sig = TransitSignal(
                delay_minutes=curr_delay,
                normal_delay_minutes=norm_delay,
                pct_increase=transit_pct,
                primary_corridor=geo["primary_corridor"],
                active_lines_delayed=4,
                deduction=t_ded
            )
            inc_sig = IncidentsSignal(
                count=curr_incidents,
                normal_count=norm_incidents,
                pct_increase=incidents_pct,
                threshold=threshold,
                threshold_exceeded=True,
                primary_category="Waterlogging & Tree Falls",
                primary_category_hi="जलभराव और पेड़ गिरने की घटनाएं",
                deduction=i_ded
            )
            traf_sig = TrafficSignal(
                congestion_level="Severe",
                congestion_level_hi="गंभीर जाम",
                speed_kmh=curr_speed,
                normal_speed_kmh=norm_speed,
                travel_time_increase_pct=traffic_pct,
                bottleneck_junction=geo["bottleneck_junction"],
                roads_affected=18,
                deduction=tr_ded
            )
            breakdown = ScoreBreakdown(
                normal_pulse=normal_pulse,
                weather_deduction=w_ded,
                transit_deduction=t_ded,
                incidents_deduction=i_ded,
                traffic_deduction=tr_ded,
