def format_say_bar(step: int, lang: str, state: Dict[str, Any]) -> str:
    script_dict = SAY_BAR_HI if lang == "hi" else SAY_BAR_EN
    template = script_dict.get(step, script_dict[1])

    zone_id = state.get("active_location_id") or state.get("active_zone_id", "delhi_cp")
    zone_data = state["zones"][zone_id]
    loc = zone_data["location"]
    is_hi = (lang == "hi")

    z_name = loc["local_area_hi"] if is_hi else loc["local_area"]
    district = loc["district_hi"] if is_hi else loc["district"]
    state_name = loc["state_hi"] if is_hi else loc["state"]
    country = "भारत" if is_hi else loc["country"]
    lat = f"{loc['latitude']:.4f}° N"
    lon = f"{loc['longitude']:.4f}° E"

    pulse = zone_data["pulse"]
    status = zone_data["status_hi"] if is_hi else zone_data["status"]
    normal_pulse = zone_data["normal_pulse"]

    delay = zone_data["transit"]["delay_minutes"]
    norm_delay = zone_data["transit"]["normal_delay_minutes"]
    transit_pct = zone_data["transit"]["pct_increase"]
    corridor = zone_data["transit"]["primary_corridor"]

    incidents = zone_data["incidents"]["count"]
    norm_inc = zone_data["incidents"]["normal_count"]
    incidents_pct = zone_data["incidents"]["pct_increase"]

    traffic_pct = zone_data["traffic"]["travel_time_increase_pct"]
    bottleneck = zone_data["traffic"]["bottleneck_junction"]
    speed = zone_data["traffic"]["speed_kmh"]

    weather_desc = zone_data["weather"]["condition_hi"] if is_hi else zone_data["weather"]["condition"]
    aqi = zone_data["weather"]["aqi"]

    brk = zone_data["breakdown"]
    w_ded = brk["weather_deduction"]
    t_ded = brk["transit_deduction"]
    i_ded = brk["incidents_deduction"]
    tr_ded = brk["traffic_deduction"]
    tot_ded = brk["total_deduction"]

    risk_level = zone_data["forecast"]["risk_level_hi"] if is_hi else zone_data["forecast"]["risk_level"]
    alert_prio = zone_data["alert"]["priority_hi"] if (zone_data.get("alert") and is_hi) else (zone_data["alert"]["priority"] if zone_data.get("alert") else "HIGH")

    best_z = state["best_zone"]["name_hi"] if is_hi else state["best_zone"]["name"]
    best_sc = state["best_zone"]["pulse"]
    second_z = state["second_zone"]["name_hi"] if is_hi else state["second_zone"]["name"]
    second_sc = state["second_zone"]["pulse"]

    summary_excerpt = (zone_data["resident_advice_hi"] if is_hi else zone_data["resident_advice"])[:85] + "..."

    timestamps = {}
    for ev in zone_data["timeline"]:
        if "45m" in ev["timestamp_offset"]:
            timestamps["t1"] = ev["time_label"]
        elif "30m" in ev["timestamp_offset"]:
            timestamps["t2"] = ev["time_label"]
        elif "15m" in ev["timestamp_offset"]:
            timestamps["t3"] = ev["time_label"]
        elif "Right Now" in ev["timestamp_offset"] or "Now" in ev["timestamp_offset"]:
            timestamps["t4"] = ev["time_label"]

    formatted = template.format(
        country=country,
        state=state_name,
        district=district,
        zone=z_name,
        lat=lat,
        lon=lon,
        corridor=corridor,
        bottleneck=bottleneck,
        aqi=aqi,
        speed=speed,
        pulse=pulse,
        status=status,
        normal_pulse=normal_pulse,
        delay=delay,
        normal_delay=norm_delay,
        transit_pct=transit_pct,
        incidents=incidents,
        normal_incidents=norm_inc,
        incidents_pct=incidents_pct,
        weather=weather_desc,
        traffic_pct=traffic_pct,
        weather_deduction=w_ded,
        transit_deduction=t_ded,
        incident_deduction=i_ded,
        traffic_deduction=tr_ded,
        total_deductions=tot_ded,
        risk_level=risk_level,
        alert_priority=alert_prio,
        best_zone=best_z,
        best_score=best_sc,
        second_zone=second_z,
        second_score=second_sc,
        plain_summary_excerpt=summary_excerpt,
        time_1=timestamps.get("t1", "14:15"),
        time_2=timestamps.get("t2", "14:30"),
        time_3=timestamps.get("t3", "14:45"),
        time_4=timestamps.get("t4", "15:00")
    )
    return formatted

