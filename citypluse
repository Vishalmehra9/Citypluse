"""
CityPulse - Data Models
Civic Health Dashboard schemas for geographic hierarchy, signals, deductions, forecasts, and alerts.
"""

from dataclasses import dataclass, asdict
from typing import List, Dict, Any, Optional

@dataclass
class GeoLocation:
    country: str
    country_code: str
    state: str
    state_hi: str
    district: str
    district_hi: str
    local_area: str
    local_area_hi: str
    latitude: float
    longitude: float
    ward_code: str
    pin_code: str
    primary_corridor: str = ""
    bottleneck_junction: str = ""
    emergency_contact: str = ""

@dataclass
class WeatherSignal:
    condition: str
    condition_hi: str
    temperature_c: int
    rainfall_mm: float
    aqi: int
    aqi_status: str
    aqi_status_hi: str
    icon: str
    deduction: int

@dataclass
class TransitSignal:
    delay_minutes: int
    normal_delay_minutes: int
    pct_increase: int
    primary_corridor: str
    active_lines_delayed: int
    deduction: int

@dataclass
class IncidentsSignal:
    count: int
    normal_count: int
    pct_increase: int
    threshold: int
    threshold_exceeded: bool
    primary_category: str
    primary_category_hi: str
    deduction: int

@dataclass
class TrafficSignal:
    congestion_level: str
    congestion_level_hi: str
    speed_kmh: int
    normal_speed_kmh: int
    travel_time_increase_pct: int
    bottleneck_junction: str
    roads_affected: int
    deduction: int

@dataclass
class ScoreBreakdown:
    normal_pulse: int
    weather_deduction: int
    transit_deduction: int
    incidents_deduction: int
    traffic_deduction: int
    total_deduction: int
    current_pulse: int

@dataclass
class ForecastSignal:
    risk_level: str
    risk_level_hi: str
    predicted_delay_range: str
    incident_trend: str
    disclaimer: str

@dataclass
class AlertSignal:
    id: str
    priority: str
    priority_hi: str
    timestamp: str
    title: str
    title_hi: str
    message: str
    message_hi: str
    recommended_actions: List[str]
    recommended_actions_hi: List[str]

@dataclass
class TimelineEvent:
    timestamp_offset: str
    time_label: str
    title: str
    title_hi: str
    description: str
    description_hi: str
    pulse_at_time: int
    icon: str

@dataclass
class Zone:
    id: str
    name: str
    name_hi: str
    location: GeoLocation
    pulse: int
    normal_pulse: int
    status: str
    status_hi: str
    status_color: str
    weather: WeatherSignal
    transit: TransitSignal
    incidents: IncidentsSignal
    traffic: TrafficSignal
    breakdown: ScoreBreakdown
    forecast: ForecastSignal
    alert: Optional[AlertSignal]
    timeline: List[TimelineEvent]
    trend_history_60m: List[int]
    correlation_detected: bool
    correlation_summary: str
    correlation_summary_hi: str
    resident_advice: str
    resident_advice_hi: str
    staff_summary: str
    staff_summary_hi: str

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)
